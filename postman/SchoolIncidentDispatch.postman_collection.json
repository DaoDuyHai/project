    {
      "name": "2. Incidents - Student",
      "description": "Các API dành cho Người báo cáo (Học sinh / Giáo viên) để tạo sự cố và theo dõi danh sách sự cố cá nhân.",
      "item": [
        {
          "name": "Tạo sự cố mới (Hỏng điện/Nước -> TECHNICAL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set(\"incidentId\", jsonData.data._id);",
                  "    console.log(\"✔ Đã tự động lưu incidentId mới tạo:\", jsonData.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Đèn trần nhấp nháy bốc khói\",\n  \"location\": \"Phòng học B204\",\n  \"type\": \"Hỏng điện/Nước/Thiết bị\",\n  \"description\": \"Đèn trần phát tiếng kêu rè rè và có khói bốc ra.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/incidents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents"]
            }
          }
        },
        {
          "name": "Tạo sự cố mới (Y tế/Cấp cứu -> MEDICAL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set(\"incidentId\", jsonData.data._id);",
                  "    console.log(\"✔ Đã tự động lưu incidentId mới tạo:\", jsonData.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Học sinh bị chảy máu cam liên tục\",\n  \"location\": \"Phòng tự học thư viện\",\n  \"type\": \"Tai nạn/Sức khỏe/Cấp cứu\",\n  \"description\": \"Học sinh hoa mắt chóng mặt và chảy nhiều máu mũi.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/incidents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents"]
            }
          }
        },
        {
          "name": "Xem danh sách sự cố của tôi (My Reports)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/my-reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents", "my-reports"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Dispatcher Workflow",
      "description": "Quy trình điều phối và xử lý sự cố của Kỹ thuật viên / Y tế: Xem việc chờ, Nhận việc (Khóa nguyên tử), và Hoàn thành.",
      "item": [
        {
          "name": "Xem danh sách sự cố chờ tiếp nhận (PENDING theo khoa)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (Array.isArray(jsonData.data) && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set(\"incidentId\", jsonData.data[0]._id);",
                  "    console.log(\"✔ Đã lưu incidentId chờ xử lý:\", jsonData.data[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents", "pending"]
            }
          }
        },
        {
          "name": "Xem danh sách công việc do tôi phụ trách (My Tasks)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/my-tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents", "my-tasks"]
            }
          }
        },
        {
          "name": "Tiếp nhận sự cố (Atomic Concurrency Lock)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents", "{{incidentId}}", "accept"]
            }
          }
        },
        {
          "name": "Hoàn thành sự cố (Resolve & Ownership Check)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionNotes\": \"Đã sửa chữa và kiểm tra lại toàn bộ trang thiết bị an toàn.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/resolve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents", "{{incidentId}}", "resolve"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Admin Management",
      "description": "Các API phân quyền Quản trị viên (Admin): Giám sát toàn bộ sự cố (lọc động & phân trang) và Thống kê tổng hợp (Aggregation Pipeline).",
      "item": [
        {
          "name": "Xem danh sách toàn trường (Lọc động & Phân trang)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents?status=PENDING&department=TECHNICAL&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                },
                {
                  "key": "department",
                  "value": "TECHNICAL"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Thống kê số liệu Analytics (MongoDB Aggregation Pipeline)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents", "analytics"]
            }
          }
        }
      ]
    },
    {
      "name": "5. RBAC Negative Tests (Kiểm tra chặn quyền)",
      "description": "Bộ test kiểm thử ma trận phân quyền: Mô phỏng hành vi vượt quyền (Student gọi API Admin/Dispatcher) để chứng minh server luôn trả về đúng HTTP 403 Forbidden.",
      "item": [
        {
          "name": "Student cố tình gọi API Analytics của Admin (Kỳ vọng: 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Bảo mật: Chặn sinh viên truy cập route Admin (Trả về 403 Forbidden)\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents", "analytics"]
            }
          }
        },
        {
          "name": "Student cố tình gọi API Tiếp nhận sự cố của Dispatcher (Kỳ vọng: 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Bảo mật: Chặn sinh viên tự nhận xử lý sự cố (Trả về 403 Forbidden)\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents", "{{incidentId}}", "accept"]
            }
          }
        },
        {
          "name": "Dispatcher Kỹ thuật cố tình gọi API Analytics của Admin (Kỳ vọng: 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Bảo mật: Chặn Dispatcher truy cập bảng Analytics của Admin (Trả về 403 Forbidden)\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents", "analytics"]
            }
          }
        }
      ]
    }
  ]
