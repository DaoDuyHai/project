{
  "info": {
    "_postman_id": "school-incident-dispatch-collection-2026",
    "name": "School Incident Dispatch System API",
    "description": "Toàn bộ bộ sưu tập RESTful API phục vụ kiểm thử Hệ thống Điều phối & Xử lý sự cố học đường (Authentication, Student Reports, Dispatcher Workflow, Admin Analytics, và RBAC Negative Tests).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "incidentId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
